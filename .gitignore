.env
.env.*
*.env

# --- OS ---
.DS_Store
Thumbs.db
*.tmp
*.swp
*~

# --- IDE ---
.vscode/
.idea/
*.code-workspace

# --- Speckit internals ---
# Keep .specify/ tracked (framework scripts/templates)
